{
  "name": "coderecall",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host localhost",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host localhost",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/check-memory.mjs",
    "test:answers": "python scripts/check-review-tests.py && python scripts/check-structure.py",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "ts-fsrs": "5.4.2",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module",
  "license": "MIT",
  "description": "CodeRecall · 码上记：基于 FSRS 间隔重复的 ACM 刷题记忆工具。",
  "repository": {
    "type": "git",
    "url": "https://github.com/ryan-zhu111/CodeRecall.git"
  }
}
